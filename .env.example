# =============================================================================
# DESENVOLVIMENTO - Copiar para .env e ajustar os valores
# =============================================================================

# Core Settings
SECRET_KEY=your-secret-key-here-generate-a-new-one-for-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DB_NAME=tuwi_dev
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Email (Development)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@tuwi.pt
CONTACT_EMAIL=contact@tuwi.pt

# AWS S3 (Production only)
USE_S3=False
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_STORAGE_BUCKET_NAME=tuwi-media-bucket
# AWS_S3_REGION_NAME=eu-west-1

# Email Service (Production)
# EMAIL_BACKEND=anymail.backends.mailgun.EmailBackend
# MAILGUN_API_KEY=your_mailgun_api_key
# MAILGUN_SENDER_DOMAIN=mail.tuwi.pt

# Stripe (when implementing payments)
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Redis (when implementing Celery/Channels)
# REDIS_URL=redis://localhost:6379/0