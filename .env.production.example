# =============================================================================
# PRODUCTION ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env on your production server and configure the values

# Django Settings
DJANGO_SETTINGS_MODULE=core.settings
SECRET_KEY=GENERATE_A_STRONG_SECRET_KEY_HERE
DEBUG=False
ALLOWED_HOSTS=72.61.190.180,api.proenglish.ao,localhost,127.0.0.1

# Database Configuration (Neon PostgreSQL)
USE_POSTGRESQL=True
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@YOUR_HOST.neon.tech/neondb?sslmode=require

# CORS Settings (add your frontend domain)
CORS_ALLOWED_ORIGINS=https://proenglish.ao,https://www.proenglish.ao,http://72.61.190.180,http://localhost:3000

# OpenAI API Configuration
OPENAI_API_KEY=your-openai-api-key
OPENAI_ORGANIZATION_ID=your-organization-id

# Frontend URL
FRONTEND_URL=https://proenglish.ao

# Email Settings (Gmail SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=ProEnglish <your-email@gmail.com>

# AWS S3 Settings (optional - set USE_S3=True to enable)
USE_S3=False
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET_NAME=your-bucket-name
AWS_S3_REGION_NAME=us-east-1
AWS_CLOUDFRONT_DOMAIN=https://your-cloudfront-domain.cloudfront.net

# Google OAuth
GOOGLE_OAUTH2_CLIENT_ID=your-google-client-id
GOOGLE_OAUTH2_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH2_REDIRECT_URI=https://proenglish.ao/auth/google/callback

# VAPI Integration
VAPI_PRIVATE_KEY=your-vapi-private-key
VAPI_PUBLIC_KEY=your-vapi-public-key
VAPI_ORG_ID=your-vapi-org-id
VAPI_BASE_URL=https://api.vapi.ai
VAPI_WEBHOOK_SECRET=your-webhook-secret
VAPI_WEBHOOK_URL=https://api.proenglish.ao/api/v1/practice/vapi/webhook/
BACKEND_BASE_URL=https://api.proenglish.ao
VAPI_DEFAULT_VOICE=alloy
VAPI_TTS_PROVIDER=openai
VAPI_STT_PROVIDER=openai
VAPI_ENGLISH_ASSISTANT_ID=your-assistant-id

# Redis Configuration
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=your-redis-password
